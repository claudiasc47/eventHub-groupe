# URL de l'API unique (contrat v0.1). Copier ce fichier en `.env`, puis relancer Vite après toute modification.
# Les variables VITE_* sont intégrées au bundle et visibles dans le navigateur : n'y mettre aucun secret.
VITE_API_URL=http://localhost:3000/api

# Simule les trois routes d’authentification en développement avec MSW.
VITE_MOCK_AUTH=false

VITE_MOCK_BOOKINGS=false
