# ==========================================
# Base de données PostgreSQL
# ==========================================
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub_local_password
POSTGRES_DB=eventhub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eventhub:eventhub_local_password@db:5432/eventhub

# ==========================================
# Back-end (API NestJS)
# ==========================================
API_PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_local_env_secret_key
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Front-end (SPA React / Vite)
# ==========================================
WEB_PORT=5173
VITE_API_URL=http://localhost:3000/api
